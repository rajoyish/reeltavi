{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "ReelTavi – Video Controller for Facebook"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "css": [
        "content.css"
      ],
      "js": [
        "download-source.js",
        "content.js"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://*.facebook.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Control playback, volume and fullscreen on Facebook videos and Reels, and download videos with audio.",
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "name": "ReelTavi – Video Controller for Facebook",
  "permissions": [
    "storage",
    "downloads",
    "offscreen"
  ],
  "version": "1.4.0",
  "background": {
    "service_worker": "download-worker.js"
  },
  "homepage_url": "https://github.com/rajoyish/reeltavi"
}
